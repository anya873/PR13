<Window x:Class="Interface_Shapovalova.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#FF3F3F3F">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Visible" Margin="10,10,10,10">
            <StackPanel x:Name="ParentUser" Orientation="Vertical">
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Visible" Margin="10">
                <StackPanel x:Name="parentMessage" Orientation="Vertical"/>
            </ScrollViewer>

            <TextBox x:Name="Message" Grid.Row="1" Padding="5" Margin="10,0,10,10" Height="50" Background="Black" Foreground="White" KeyUp="SendMessages">
                <TextBox.Effect>
                    <DropShadowEffect/>
                </TextBox.Effect>
            </TextBox>
        </Grid>
    </Grid>
</Window>