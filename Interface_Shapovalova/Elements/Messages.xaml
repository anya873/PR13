<UserControl x:Class="Interface_Shapovalova.Elements.Messages"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" 
             MouseDoubleClick="EditMessage" 
             MouseRightButtonDown="DeleteMessage">
    <Grid Background="Black" Margin="5" MinHeight="69">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border CornerRadius="15" Width="30" Height="30" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border.Background>
                <ImageBrush ImageSource="/Interface_Shapovalova;component/Images/2.jpg"/>
            </Border.Background>
        </Border>

        <TextBlock x:Name="Message" Margin="45,5,5,5" Padding="5" TextWrapping="Wrap" Foreground="White" Grid.Row="0"/>

        <Image x:Name="AttachedImage" Grid.Row="1" Margin="45,0,10,10" MaxHeight="300" HorizontalAlignment="Left" Stretch="Uniform" Visibility="Collapsed"/>

        <TextBlock x:Name="Date" Margin="0,0,5,5" TextWrapping="Wrap" Foreground="White" VerticalAlignment="Bottom" HorizontalAlignment="Right" Grid.Row="1"/>

        <Grid.Effect>
            <DropShadowEffect/>
        </Grid.Effect>
    </Grid>
</UserControl>